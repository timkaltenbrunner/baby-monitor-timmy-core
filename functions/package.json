{
  "name": "babymonitortimmy-functions",
  "description": "Cloud Functions for Baby Monitor Timmy",
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "lint": "node --check index.js && node --check lib/public_helpers.js && node --check lib/referral_helpers.js && node --check lib/admin_sessions_helpers.js && node --check lib/cleanup_helpers.js",
    "test:unit": "node --test test/public_helpers.test.js test/referral_helpers.test.js test/admin_sessions_helpers.test.js test/cleanup_helpers.test.js",
    "test:rules": "node --test test/firestore.rules.test.js",
    "deploy:rules": "cd .. && firebase deploy --only firestore:rules --project baby-monitor-timmy",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "google-auth-library": "^10.6.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.12.1"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.0",
    "protobufjs": "^7.5.5"
  }
}
