rules_version = '2';
// Baby Monitor Timmy - Firestore Security Rules
//
// Mobile clients receive a Firebase Auth custom claim via registerMobileClient
// (App Check protected). Web clients can only access normal signaling after a
// premium mobile client has authorized the browser and the active lease is
// still valid.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'DcyIopcaDjUCcHbUhx0VHYM8hZ33';
    }

    function validPairingDocKey(pairingDocKey) {
      return pairingDocKey is string
        && pairingDocKey.matches('^[a-f0-9]{64}$');
    }

    function isMobileClient() {
      return signedIn() && request.auth.token.clientType == 'mobile';
    }

    function webSessionPath() {
      return /databases/$(database)/documents/web_client_sessions/$(request.auth.uid);
    }

    function webSession() {
      return get(webSessionPath()).data;
    }

    function hasActiveWebSession(pairingDocKey) {
      return signedIn()
        && request.auth.token.clientType == 'web'
        && validPairingDocKey(pairingDocKey)
        && exists(webSessionPath())
        && webSession().status == 'active'
        && webSession().webUid == request.auth.uid
        && webSession().webSessionId == request.auth.token.webSessionId
        && webSession().pairingDocKey == pairingDocKey
        && webSession().leaseExpiresAt > request.time
        && webSession().maxExpiresAt > request.time;
    }

    function canUsePairing(pairingDocKey) {
      return isMobileClient() || hasActiveWebSession(pairingDocKey);
    }

    function validSessionKeys() {
      return request.resource.data.keys().hasOnly(
        ['pairingDocKey', 'status', 'offerSdp', 'answerSdp',
         'createdAt', 'updatedAt', 'version', 'signalingClearedAt',
         'babyPremium', 'parentPremium',
         'babyTurnProvider', 'babyTurnProviders',
         'parentTurnProvider', 'parentTurnProviders',
         'babyActiveTurnUrl', 'babyActiveTurnProtocol', 'babyActiveTurnProvider',
         'parentActiveTurnUrl', 'parentActiveTurnProtocol', 'parentActiveTurnProvider',
         'qualityEventCount', 'qualityEventsTail', 'lastQualityEvent',
         'connectionInterruptionCount', 'lastConnectionIssue',
         'turnChangeCount', 'lastTurnChange']);
    }

    function validCandidatePayload() {
      return request.resource.data.keys().hasAll(['candidate', 'ts'])
        && request.resource.data.keys().hasOnly(
             ['candidate', 'sdpMid', 'sdpMLineIndex', 'ts'])
        && request.resource.data.candidate is string
        && request.resource.data.candidate.size() < 8192;
    }

    match /admin/turn_config {
      allow read, write: if isAdmin();
    }

    match /admin/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /web_client_sessions/{webUid} {
      allow read: if signedIn() && request.auth.uid == webUid;
      allow write: if false;
    }

    match /web_client_mobiles/{mobileUid} {
      allow read, write: if false;
    }

    match /sessions/{sessionId} {
      allow read, delete: if canUsePairing(resource.data.pairingDocKey);
      allow create: if canUsePairing(request.resource.data.pairingDocKey)
        && request.resource.data.keys().hasAll(['pairingDocKey', 'status'])
        && validSessionKeys()
        && request.resource.data.status is string;
      allow update: if canUsePairing(resource.data.pairingDocKey)
        && request.resource.data.pairingDocKey == resource.data.pairingDocKey
        && validSessionKeys()
        && request.resource.data.status is string;
    }

    match /sessions/{sessionId}/candidates_baby/{id} {
      allow read, delete: if canUsePairing(
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.pairingDocKey
      );
      allow create: if canUsePairing(
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.pairingDocKey
      ) && validCandidatePayload();
    }

    match /sessions/{sessionId}/candidates_parent/{id} {
      allow read, delete: if canUsePairing(
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.pairingDocKey
      );
      allow create: if canUsePairing(
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.pairingDocKey
      ) && validCandidatePayload();
    }

    match /pairing_codes/{code} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['createdAt', 'pubkeys', 'status',
              'peerType', 'webUid', 'webSessionId'])
        && request.resource.data.pubkeys is map
        && request.resource.data.pubkeys.size() <= 2
        && request.resource.data.pubkeys[request.auth.uid] is string
        && request.resource.data.pubkeys[request.auth.uid].size() < 512;
    }

    match /pairings/{pairingId} {
      allow read, delete: if canUsePairing(pairingId);
      allow create: if canUsePairing(pairingId)
         && request.resource.data.keys().hasAll(['status', 'createdAt'])
         && request.resource.data.keys().hasOnly(
             ['status', 'createdAt', 'updatedAt', 'activeSessionId',
              'selectedMode', 'selectedBy', 'subscriptionMembers'])
         && request.resource.data.status is string;
      allow update: if canUsePairing(pairingId)
         && request.resource.data.keys().hasOnly(
             ['status', 'createdAt', 'updatedAt', 'activeSessionId',
              'selectedMode', 'selectedBy', 'subscriptionMembers']);
    }

    match /gift_codes/{nonce} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /campaign_codes/{slug} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /campaign_redemptions/{id} {
      allow read: if false;
      allow write: if false;
    }
  }
}
